{
  "name": "volstudio-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execSync('simple-git-hooks',{stdio:'inherit'})}catch(e){console.warn('\\n[postinstall] UYARI: git hook kurulumu atlandi (git deposi degil veya git yok). Kalite kapilari (pnpm quick/high) elle calistirilmali.\\n')}\"",
    "quick": "just quick",
    "fast": "just fast",
    "high": "just high",
    "signoff": "just signoff",
    "doctor:env": "just doctor",
    "dev": "pnpm --parallel -r --filter @volstudio/vol-hell --filter @volstudio/vol-ui --filter @volstudio/vol-asset-studio run dev",
    "build:game": "pnpm --filter @volstudio/vol-hell build",
    "build:tauri": "pnpm run build:game && pnpm --filter @volstudio/tauri-v2 tauri build",
    "tauri:dev": "pnpm --filter @volstudio/tauri-v2 tauri dev --config tauri.dev.conf.json",
    "tauri:build": "pnpm --filter @volstudio/tauri-v2 tauri build",
    "tauri:android:dev": "pnpm --filter @volstudio/tauri-v2 tauri android dev --config tauri.dev.conf.json",
    "tauri:ios:dev": "pnpm --filter @volstudio/tauri-v2 tauri ios dev --config tauri.dev.conf.json",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write \"**/*.{ts,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,css,json,md}\"",
    "gen:theme": "node core/scripts/gen-theme.mjs",
    "convert:ios": "tsx core/scripts/convert-audio.ts games/vol-hell/public/assets/audio",
    "audio:qa": "tsx core/scripts/audio-qa.ts games/vol-hell/public/assets/audio",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "build:all": "pnpm -r --if-present build",
    "contract": "node scripts/workspace-contract.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.0.0",
    "eslint-config-prettier": "10.0.0",
    "just-install": "^2.0.2",
    "prettier": "3.0.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.58.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11.18.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm quick",
    "pre-push": "pnpm high"
  }
}
