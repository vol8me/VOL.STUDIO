{
  "name": "@volstudio/vol-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "benchmark:fields": "tsx scripts/benchmark-fields.mts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev --config src-tauri/tauri.dev.conf.json",
    "tauri:android:build": "tauri android build --apk"
  },
  "dependencies": {
    "@volstudio/core": "workspace:*",
    "@volstudio/tauri-v2": "workspace:*",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "i18next": "26.3.6",
    "jsdom": "25.0.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "3.2.6"
  }
}
