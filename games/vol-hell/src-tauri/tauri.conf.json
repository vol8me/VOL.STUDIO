{
  "productName": "VOL.HELL",
  "mainBinaryName": "VOL.HELL",
  "version": "0.1.0",
  "identifier": "com.volstudio.game",
  "build": {
    "beforeDevCommand": "pnpm --filter @volstudio/vol-hell dev",
    "beforeBuildCommand": "pnpm --filter @volstudio/vol-hell build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VOL.HELL",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'unsafe-inline' 'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "linux.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux.desktop.hbs"
      }
    },
    "icon": [
      "../../../tauri-v2/src-tauri/icons/32x32.png",
      "../../../tauri-v2/src-tauri/icons/128x128.png",
      "../../../tauri-v2/src-tauri/icons/128x128@2x.png",
      "../../../tauri-v2/src-tauri/icons/icon.icns",
      "../../../tauri-v2/src-tauri/icons/icon.ico"
    ]
  },
  "plugins": {}
}
