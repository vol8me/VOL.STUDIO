#!/usr/bin/env bash

# Çizim yolu seçimi kabuğundur (configure_linux_webview): launcher değişken
# dayatırsa kabuğun sürücüye göre ölçülmüş kuralı devre dışı kalır.
set -e

this_dir="$(readlink -f "$(dirname "$0")")"

# linuxdeploy GTK hook'u `GDK_BACKEND=x11` ile sabitler; bu AppImage'ı
# daima XWayland yoluna iter ve paylaşılan kabuğun sürücüye göre seçtiği
# çizim kuralını devre dışı bırakır. Dışarıdan değer gelmediyse ve oturum
# yerel Wayland ise arka uç Wayland'e çevrilir; kullanıcı değer verdiyse
# o değer korunur; saf X11 oturumlarında hook'un x11 dayatması kalır.
original_gdk_backend="${GDK_BACKEND:-}"
source "$this_dir/apprun-hooks/linuxdeploy-plugin-gtk.sh"
if [ -n "$original_gdk_backend" ]; then
    export GDK_BACKEND="$original_gdk_backend"
elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export GDK_BACKEND=wayland
fi

# linuxdeploy AppRun, GStreamer sistem yolunu AppDir'e yönlendirir. Scanner ve
# registry de aynı izole runtime'a sabitlenmezse host cache'i eski/uyumsuz
# plugin sonuçlarını taşıyabilir ve WebKitGTK sessiz kalabilir.
gst_plugin_dir="$this_dir/usr/lib/gstreamer-1.0"
gst_scanner="$this_dir/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
gst_cache_root="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/vol-hell"
mkdir -p "$gst_cache_root"

export GST_PLUGIN_PATH_1_0="$gst_plugin_dir"
export GST_PLUGIN_SYSTEM_PATH_1_0="$gst_plugin_dir"
export GST_PLUGIN_SCANNER_1_0="$gst_scanner"
export GST_REGISTRY_1_0="$gst_cache_root/gstreamer-registry.bin"

exec "$this_dir/AppRun.wrapped" "$@"
