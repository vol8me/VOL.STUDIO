{
  "name": "@volstudio/vol-hell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:sounds": "tsx ../../core/scripts/generate-volhell-sounds.ts public/assets/audio/sfx",
    "generate:music": "tsx ../../core/scripts/generate-iron-vein.ts public/assets/audio/music/main-menu/iron-vein.ogg && tsx ../../core/scripts/generate-black-tide.ts public/assets/audio/music/main-menu/black-tide.ogg && tsx ../../core/scripts/generate-crimson-horizon.ts public/assets/audio/music/main-menu/crimson-horizon.ogg && tsx ../../core/scripts/generate-ambient-tracks.ts public/assets/audio/music",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:audio": "pnpm run generate:sounds && pnpm run generate:music"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@volstudio/core": "workspace:*",
    "@volstudio/tauri-v2": "workspace:*",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "i18next": "26.3.6",
    "jsdom": "25.0.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "3.0.5"
  }
}
