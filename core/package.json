{
  "name": "@volstudio/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./math/Vector2": {
      "import": "./src/math/Vector2.ts",
      "types": "./src/math/Vector2.ts"
    },
