    },
    "./ui/colors": {
      "import": "./src/ui/colors.ts",
      "types": "./src/ui/colors.ts"
    },
    "./ui": {
      "import": "./src/ui/index.ts",
      "types": "./src/ui/index.ts"
    },
    "./ui/styles.css": "./src/ui/theme.css",
    "./lifecycle": {
      "import": "./src/lifecycle/index.ts",
      "types": "./src/lifecycle/index.ts"
    },
    "./i18n": {
      "import": "./src/i18n/index.ts",
