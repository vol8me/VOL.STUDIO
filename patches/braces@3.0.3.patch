diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..c472185e1a1e297b47dce751b10cc03e28d8263e
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,12 @@
+'use strict';
+
+const { MAX_DEPTH } = require('./constants');
+
+// Bounds brace and parenthesis nesting so the recursive walkers (compile,
+// expand, stringify) cannot exhaust the call stack. It guards parsed input and
+// ASTs handed in directly.
+module.exports = level => {
+  if (level > MAX_DEPTH) {
+    throw new SyntaxError(`Maximum nesting depth exceeded (${MAX_DEPTH})`);
+  }
+};
