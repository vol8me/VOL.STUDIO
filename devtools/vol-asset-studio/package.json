{
  "name": "@volstudio/vol-asset-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/cli.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/cli.js --production",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:full": "VOL_E2E_FULL=1 playwright test"
  },
  "dependencies": {
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.3",
    "@volstudio/core": "workspace:*",
    "chokidar": "5.0.0",
    "fastify": "5.12.1",
    "i18next": "26.3.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "jsdom": "25.0.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "3.0.5"
  }
}
