{
  "schema": "OrganicCanaryV1",
  "id": "campfire",
  "version": 1,
  "title": "Kamp ateşi",
  "purpose": "source.fire: çatırtı olayları + alçak uğultu + tıslama katmanları.",
  "source": {
    "kind": "program",
