            [0.44, -1.5],
            [0.682, -5],
            [0.88, -8],
            [1.1, -40]
          ]
        },
        "f1": {
          "curve": "curve.spline",
          "version": 1,
          "points": [
            [0, 380],
            [0.165, 750],
            [0.495, 880],
            [0.825, 600],
            [1.1, 330]
          ]
        },
        "f2": {
          "curve": "curve.spline",
          "version": 1,
