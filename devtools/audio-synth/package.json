{
  "name": "@volstudio/audio-synth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./writer": {
      "import": "./src/writer.ts",
      "types": "./src/writer.ts"
    },
    "./protocol": {
      "import": "./src/protocol/index.ts",
      "types": "./src/protocol/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa": "tsx scripts/audio-qa.ts",
    "bench:budget": "tsx scripts/render-budget-bench.ts",
    "audio:reference-check": "tsx scripts/audio-reference-check.ts",
    "audio:job": "tsx scripts/audio-job.ts",
    "audio:production-check": "tsx scripts/audio-job.ts verify --all",
    "demo:music": "tsx scripts/music-demo.ts",
    "convert:ios": "tsx scripts/convert-audio.ts"
  },
  "dependencies": {
    "@volstudio/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
