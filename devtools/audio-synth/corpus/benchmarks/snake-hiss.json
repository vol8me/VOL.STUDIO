{
  "schema": "BenchmarkTaskV1",
  "id": "snake-hiss",
  "version": 1,
  "title": "Yılan tıslaması",
  "purpose": "source.airflow dar açıklık + yüksek sibilance: sürekli, perdesiz, parlak hava akımı.",
  "category": "sibilance",
  "parts": [
    {
      "id": "main",
      "source": {
        "kind": "program",
        "program": {
          "schema": "AcousticProgramV1",
          "sampleRate": 48000,
          "channels": 1,
          "durationSeconds": 2.0,
          "seed": 31,
          "master": {
            "normalize": "peak",
            "peakDbfs": -3,
            "fadeInSeconds": 0.15,
            "fadeOutSeconds": 0.4
          },
          "layers": [
            {
              "name": "hiss",
              "source": {
                "primitive": "source.airflow",
                "version": 1,
                "params": {
                  "pressure": 0.8,
                  "sibilance": 0.9,
                  "turbulence": 0.35,
                  "aperture": 1.2,
                  "cavity": 0.3,
                  "tilt": 0.7
                }
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "kind": "asset-policy",
          "assetClass": "sfx"
        },
        {
          "kind": "clipping"
        },
        {
          "kind": "clicks",
          "max": 0
        },
        {
          "kind": "aperiodic",
          "maxConfidence": 0.3
        },
        {
          "kind": "descriptor",
          "descriptor": "durationSeconds",
          "min": 1.2,
          "max": 3.0
        },
        {
          "kind": "descriptor",
          "descriptor": "centroidHz",
          "min": 4000
        },
        {
          "kind": "onset-rate",
          "max": 3
        },
        {
          "kind": "band-dominance",
          "dominant": "air",
          "over": "mid"
        }
      ]
    }
  ],
  "listeningGuide": [
    "Sürekli, dengeli bir tıslama; içinde ton, bipleme ya da kabarcık olmamalı.",
    "Hata belirtileri: buhar kazanı gürültüsü, perdeli vızıltı, düzensiz patlamalar."
  ]
}
