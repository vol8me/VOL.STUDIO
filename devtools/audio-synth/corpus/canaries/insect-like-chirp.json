{
  "schema": "OrganicCanaryV1",
  "id": "insect-like-chirp",
  "version": 1,
  "title": "Böceksi cırlama",
  "purpose": "Yüksek hızlı timbal tıkları (180 Hz) → yüksek frekanslı çubuk modları → üç darbe paketi.",
  "source": {
    "kind": "program",
    "program": {
      "schema": "AcousticProgramV1",
      "sampleRate": 48000,
      "channels": 1,
      "durationSeconds": 0.8,
      "seed": 16,
      "master": {
        "normalize": "peak",
        "peakDbfs": -3,
        "fadeOutSeconds": 0.02
      },
      "gestures": {
        "env": {
          "curve": "curve.linear",
          "version": 1,
          "points": [
            [0, -60],
            [0.01, 0],
            [0.12, 0],
            [0.13, -60],
            [0.25, -60],
            [0.26, 0],
            [0.37, 0],
            [0.38, -60],
            [0.5, -60],
            [0.51, 0],
            [0.62, 0],
            [0.63, -60],
            [0.8, -60]
          ]
        }
      },
      "layers": [
        {
          "name": "timbal",
          "source": {
            "primitive": "exciter.membrane",
            "version": 1,
            "params": {
              "rate": 180,
              "tension": 0.9,
              "buckleDecay": 0.001
            }
          },
          "resonators": [
            {
              "primitive": "resonator.modal",
              "version": 1,
              "params": {
                "layout": "bar",
                "frequency": 4200,
                "decay": 0.02,
                "modes": 4,
                "brightness": 0.8
              }
            }
          ],
          "articulation": {
            "primitive": "articulation.amplitude",
            "version": 1,
            "params": {
              "level": {
                "gesture": "env"
              }
            }
          }
        }
      ]
    }
  },
  "expectations": [
    {
      "kind": "pulse-rate",
      "min": 160,
      "max": 200
    },
    {
      "kind": "band-dominance",
      "dominant": "high",
      "over": "low"
    },
    {
      "kind": "clipping"
    }
  ],
  "listeningGuide": [
    "Üç kısa, tiz, cızırtılı cırlama paketi beklenir.",
    "Hata belirtileri: saf bip, paketler arasında sızıntı, alçak frekans gümbürtüsü.",
    "Ad çağrışımdır; belirli bir türe benzerlik iddiası yoktur."
  ]
}
