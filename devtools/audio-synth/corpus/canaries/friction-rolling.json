  "expectations": [
    {
      "kind": "onset-rate",
      "min": 5,
      "max": 25
    },
    {
      "kind": "band-dominance",
      "dominant": "mid",
      "over": "low"
    },
    {
      "kind": "descriptor",
      "descriptor": "activeSeconds",
      "min": 2.5
    },
