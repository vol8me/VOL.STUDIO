{
  "schema": "BenchmarkTaskV1",
  "id": "motor-acceleration",
  "version": 1,
  "title": "Motor hızlanması",
  "purpose": "source.machine rpm gesture ile hızlanan dört silindirli makine: yükselen perde, sabit döngü karakteri.",
  "category": "machine",
  "parts": [
    {
      "id": "main",
      "source": {
        "kind": "program",
        "program": {
          "schema": "AcousticProgramV1",
          "sampleRate": 48000,
          "channels": 1,
          "durationSeconds": 4.0,
          "seed": 43,
          "gestures": {
            "rev": {
              "curve": "curve.spline",
              "version": 1,
              "points": [
                [0, 500],
                [3.0, 5200],
                [4, 5200]
              ]
            }
          },
          "master": {
            "normalize": "peak",
            "peakDbfs": -3,
            "fadeInSeconds": 0.05,
            "fadeOutSeconds": 0.3
          },
          "layers": [
            {
              "name": "motor",
              "source": {
                "primitive": "source.machine",
                "version": 1,
                "params": {
                  "mechanism": "engine",
                  "count": 4,
                  "rpm": {
                    "gesture": "rev"
                  },
                  "harmonics": 14,
                  "load": 0.6,
                  "noise": 0.4,
                  "tilt": 0.6,
                  "imbalance": 0.15,
                  "bearing": 0.2
                }
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "kind": "asset-policy",
          "assetClass": "sfx"
        },
        {
          "kind": "clipping"
        },
        {
          "kind": "clicks",
          "max": 0
        },
        {
          "kind": "descriptor",
          "descriptor": "durationSeconds",
          "min": 3.0,
          "max": 5.5
        },
        {
          "kind": "pitch-contour",
          "shape": "rising",
          "minRatio": 1.5
        },
        {
          "kind": "pitch",
          "min": 60,
          "max": 1500,
          "minConfidence": 0.5
        },
        {
          "kind": "descriptor",
          "descriptor": "centroidHz",
          "min": 150,
          "max": 1200
        },
        {
          "kind": "onset-rate",
          "max": 8
        }
      ]
    }
  ],
  "listeningGuide": [
    "Motorun düşükten yüksek devre düzgün çıkması; vites değişimi ya da perde sıçraması yok.",
    "Hata belirtileri: sabit devir, düşen perde, elektrik şarjı gibi üst bant vınlama."
  ]
}
