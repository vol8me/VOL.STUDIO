          "min": 3000
        },
        {
          "kind": "onset-rate",
          "min": 1,
          "max": 12
        },
        {
          "kind": "band-dominance",
          "dominant": "high",
          "over": "low"
        },
        {
          "kind": "descriptor",
          "descriptor": "attackSeconds",
          "max": 0.4
        }
      ]
    }
  ],
  "listeningGuide": [
    "Metal yüzeyin tek yönlü, hafif gıcırtılı sürtünmesi; zımpara değil metalik kayma.",
    "Hata belirtileri: krema sıyırığı gibi yumuşak ses, perdeli keman yayı, darbe serisi."
  ]
