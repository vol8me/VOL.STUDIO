          "durationSeconds": 1.4,
          "seed": 41,
          "master": {
            "normalize": "peak",
            "peakDbfs": -3,
            "fadeInSeconds": 0.05,
            "fadeOutSeconds": 0.15
          },
          "layers": [
            {
              "name": "scrape",
              "source": {
                "primitive": "source.friction",
                "version": 1,
                "params": {
                  "material": "metal",
                  "speed": 0.55,
                  "roughness": 0.75,
                  "granularity": 4,
                  "pressure": 0.85,
                  "rolling": 0
