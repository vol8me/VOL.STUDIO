# Her satır ya bir aracın gerçekten ürettiği çıktıyı ya da açık bir güvenlik
# nedenini karşılar; üreticisi kalmayan satır silinir.

# Gizli bilgi ve imza anahtarları (Android keystore dahil)
.env
.env.*
*.pem
*.key
*.p12
*.keystore
*.jks
secrets.json

# Bağımlılıklar ve yerel araç önbellekleri (render/sample önbelleği dahil)
node_modules/

# Derleme çıktıları: Vite `dist/`, Cargo workspace `target/`, tsc artımlı bilgisi
dist/
target/
*.tsbuildinfo

# Test ve kapsam raporları (Vitest, Playwright)
coverage/
test-results/
playwright-report/

# Yerel ve yeniden üretilebilir çıktılar
# - Claude Code oturum ayarları ve yerel araştırma kaydı
# - graphify bilgi grafiği
# - audio-synth dinleme/inceleme çıktısı
.claude/
graphify-out/
devtools/*/export/

# Tauri'nin ürettiği kodlar; `gen/android` elle düzenlendiği için izlenir,
# yalnız Gradle derleme çıktısı dışarıdadır.
/devtools/deck/src-tauri/gen/
/games/*/src-tauri/gen/schemas/
/games/*/src-tauri/app-icon.svg
/games/*/src-tauri/gen/android/**/build/
/games/*/src-tauri/gen/android/.gradle/
/tauri-v2/plugins/*/android/build/
/tauri-v2/plugins/*/android/.gradle/
/games/*/src-tauri/gen/android/app/src/main/java/**/generated/
/games/*/src-tauri/gen/android/app/src/main/jniLibs/
/games/*/src-tauri/gen/android/app/src/main/assets/tauri.conf.json
/games/*/src-tauri/gen/android/app/tauri.build.gradle.kts
/games/*/src-tauri/gen/android/tauri.settings.gradle

# Deck araçları: derleme anında kopyalanan motor ve ölçüm kayıtları
/devtools/deck/web/vendor/
/devtools/deck/records/

# Editör ve işletim sistemi
.idea/
.vscode/
*.sw?
.DS_Store
Thumbs.db
desktop.ini
.directory

# Günlükler
*.log
